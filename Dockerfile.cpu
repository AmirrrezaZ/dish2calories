# CPU-only image: small, no NVIDIA toolkit needed. EfficientNet-B0 runs fine on CPU.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY . .

EXPOSE 8000 8501
ENV STREAMLIT_SERVER_HEADLESS=true \
    PYTHONUNBUFFERED=1 \
    DEVICE=cpu

# Default: API + UI in one container (see start.sh).
CMD ["bash", "start.sh"]
